# Copia este archivo como .env.local para desarrollo. En Vercel pon estas variables en
# Project Settings -> Environment Variables (NO subas .env.local a GitHub).

# Base de datos Postgres. Al conectar Neon desde el Marketplace de Vercel se crea sola (DATABASE_URL).
DATABASE_URL=postgres://usuario:clave@host/basededatos?sslmode=require

# Vercel Blob (fotos y videos). Se crea sola al conectar un Blob Store al proyecto.
BLOB_READ_WRITE_TOKEN=

# Secreto para firmar la sesion: 32+ caracteres aleatorios. Genera uno con:  openssl rand -base64 48
SESSION_SECRET=

# Super administrador (programador). Genera el hash con:  npm run hash -- 'TuContrasenaSegura123'
SUPER_EMAIL=super@glc.local
SUPER_HASH_B64=

# Correo por Gmail: activa la verificacion en 2 pasos y crea una CONTRASENA DE APLICACION nueva
# en https://myaccount.google.com/apppasswords (16 letras). Nunca tu contrasena normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_NAME=Guadalajara Lancer Club

# Direccion publica del sitio (sin / final). Se usa en el correo de aceptacion.
SITE_URL=https://tu-proyecto.vercel.app

# true = muestra los codigos de verificacion en pantalla (SOLO para pruebas). En produccion: false
DEBUG_MAIL=false
